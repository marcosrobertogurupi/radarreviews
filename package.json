{
  "name": "radar-reviews",
  "version": "1.0.0",
  "description": "SaaS multi-tenant de monitoramento de reputação online",
  "type": "module",
  "engines": {
    "node": "20.x"
  },
  "scripts": {
    "start": "tsx src/api/server.ts",
    "dev": "tsx watch src/scheduler/index.ts",
    "build": "cd admin && npm install && npm run build && cd ../portal && npm install && npm run build && cd ../website && npm install && npm run build && cd .. && rm -rf dist && mkdir -p dist/admin dist/portal && cp -rv website/out/* dist/ && cp -rv admin/dist/* dist/admin/ && cp -rv portal/dist/* dist/portal/",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src tests --ext .ts",
    "lint:fix": "eslint src tests --ext .ts --fix",
    "format": "prettier --write \"src/**/*.ts\" \"tests/**/*.ts\""
  },
  "dependencies": {
    "@google/generative-ai": "^0.24.1",
    "@supabase/supabase-js": "^2.46.2",
    "axios": "^1.7.9",
    "cheerio": "^1.2.0",
    "csv-parse": "^5.6.0",
    "date-fns": "^4.1.0",
    "dotenv": "^16.4.7",
    "iconv-lite": "^0.7.2",
    "playwright": "^1.59.1",
    "playwright-core": "^1.59.1",
    "playwright-extra": "^4.3.6",
    "playwright-stealth": "^0.0.1",
    "puppeteer-extra-plugin-stealth": "^2.11.2",
    "zod": "^3.24.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@typescript-eslint/eslint-plugin": "^8.18.2",
    "@typescript-eslint/parser": "^8.18.2",
    "eslint": "^9.17.0",
    "prettier": "^3.4.2",
    "vitest": "^2.1.8"
  }
}
