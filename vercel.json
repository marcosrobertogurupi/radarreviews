{
  "outputDirectory": "dist",
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/assets/:path*",
      "has": [
        { "type": "host", "value": "admin.reputei.com.br" }
      ],
      "destination": "/admin/assets/:path*"
    },
    {
      "source": "/:file*.:ext(png|jpg|jpeg|gif|ico|svg|json|webmanifest|txt)",
      "has": [
        { "type": "host", "value": "admin.reputei.com.br" }
      ],
      "destination": "/admin/:file*.:ext"
    },
    {
      "source": "/:path*",
      "has": [
        { "type": "host", "value": "admin.reputei.com.br" }
      ],
      "destination": "/admin/index.html"
    },
    {
      "source": "/assets/:path*",
      "has": [
        { "type": "host", "value": "(?<subdomain>app|portal)\\.reputei\\.com\\.br" }
      ],
      "destination": "/portal/assets/:path*"
    },
    {
      "source": "/:file*.:ext(png|jpg|jpeg|gif|ico|svg|json|webmanifest|txt)",
      "has": [
        { "type": "host", "value": "(?<subdomain>app|portal)\\.reputei\\.com\\.br" }
      ],
      "destination": "/portal/:file*.:ext"
    },
    {
      "source": "/:path*",
      "has": [
        { "type": "host", "value": "(?<subdomain>app|portal)\\.reputei\\.com\\.br" }
      ],
      "destination": "/portal/index.html"
    }
  ]
}
