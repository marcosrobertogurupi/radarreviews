        "message": "=<div style=\"font-family: Arial, sans-serif; max-width: 600px; margin: 0 auto; padding: 24px; background: #f9fafb;\">\n  <div style=\"background: #dc2626; color: white; padding: 16px 24px; border-radius: 8px 8px 0 0;\">\n    <h2 style=\"margin: 0; font-size: 20px;\">🚨 Alerta Crítico Sem Resposta</h2>\n    <p style=\"margin: 4px 0 0; opacity: 0.9; font-size: 13px;\">Reputei · Escalada Automática</p>\n  </div>\n  <div style=\"background: white; padding: 24px; border-radius: 0 0 8px 8px; border: 1px solid #e5e7eb; border-top: none;\">\n    <p style=\"color: #374151; font-size: 15px;\">Olá,</p>\n    <p style=\"color: #374151;\">Um review crítico está sem ação há mais de <strong>{{ $('Webhook Reputei').item.json.hours_without_action }} horas</strong> para a empresa <strong>{{ $('Webhook Reputei').item.json.tenant_name }}</strong>.</p>\n\n    <div style=\"background: #fef2f2; border: 1px solid #fecaca; border-radius: 8px; padding: 16px; margin: 16px 0;\">\n      <p style=\"margin: 0 0 8px; font-size: 13px; color: #991b1b; font-weight: 600;\">⚠️ Ação Recomendada</p>\n      <p style=\"margin: 0; color: #7f1d1d; font-size: 14px;\">{{ $('Webhook Reputei').item.json.alert_reason }}</p>\n    </div>\n\n    <table style=\"width: 100%; border-collapse: collapse; font-size: 13px; margin: 16px 0;\">\n      <tr style=\"background: #f3f4f6;\">\n        <td style=\"padding: 8px 12px; font-weight: 600; color: #6b7280; width: 35%;\">Autor</td>\n        <td style=\"padding: 8px 12px; color: #111827;\">{{ $('Webhook Reputei').item.json.review_author || '(anônimo)' }}</td>\n      </tr>\n      <tr>\n        <td style=\"padding: 8px 12px; font-weight: 600; color: #6b7280;\">Canal</td>\n        <td style=\"padding: 8px 12px; color: #111827;\">{{ $('Webhook Reputei').item.json.review_channel }}</td>\n      </tr>\n      <tr style=\"background: #f3f4f6;\">\n        <td style=\"padding: 8px 12px; font-weight: 600; color: #6b7280;\">Publicado em</td>\n        <td style=\"padding: 8px 12px; color: #111827;\">{{ $('Webhook Reputei').item.json.review_published_at }}</td>\n      </tr>\n      <tr>\n        <td style=\"padding: 8px 12px; font-weight: 600; color: #6b7280;\">Disparado em</td>\n        <td style=\"padding: 8px 12px; color: #111827;\">{{ $('Webhook Reputei').item.json.triggered_at }}</td>\n      </tr>\n    </table>\n\n    <div style=\"background: #f3f4f6; border-radius: 8px; padding: 16px; margin: 16px 0;\">\n      <p style=\"margin: 0 0 6px; font-size: 12px; color: #6b7280; font-weight: 600;\">RESUMO DO REVIEW</p>\n      <p style=\"margin: 0; color: #374151; font-size: 14px; line-height: 1.6;\">{{ $('Webhook Reputei').item.json.sentiment_summary || $('Webhook Reputei').item.json.review_body_preview }}</p>\n    </div>\n\n    {{ $('Webhook Reputei').item.json.review_url ? '<a href=\"' + $('Webhook Reputei').item.json.review_url + '\" style=\"display: inline-block; background: #4f46e5; color: white; padding: 10px 20px; border-radius: 6px; text-decoration: none; font-size: 14px;\">🔗 Ver review original</a>' : '' }}\n\n    <hr style=\"border: none; border-top: 1px solid #e5e7eb; margin: 24px 0;\">\n    <p style=\"color: #9ca3af; font-size: 12px; margin: 0;\">Reputei · Monitoramento de Reputação · Este e-mail foi enviado automaticamente.</p>\n  </div>\n</div>",
        "options": {}
